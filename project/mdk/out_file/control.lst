   29   1          // [1] 速度自适应因子计算
   30   1          v_ref = g_State.current_speed; 
   31   1          if (v_ref < 100) v_ref = 100; // 保护：最低按 100 脉冲算，防止除零
   32   1      
   33   1          // 缩放系数 = (基准速度 / 当前速度) * 1024
