                   if (right <= left + ZEBRA_MARGIN) return 0;
               
                   row_ptr = image + (uint16)row * SEARCH_IMAGE_W;
               
                   for (col = (uint8)left; col < (uint8)right; col += ZEBRA_COL_STEP) {
                       state = zebra_pixel_state(row_ptr[col]);
