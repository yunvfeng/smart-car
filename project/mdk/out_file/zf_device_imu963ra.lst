                 //  @return     uint8 edata       return ·µ»Østatus×´Ì¬
                 //  @since      v1.0
                 //  Sample usage:
                 //------------------------------------------------------------------------------------------------------
             --------------
                 static uint8 imu963ra_simspi_wr_byte(uint8 byte)
                 {
                   uint8 i;
                   for(i=0; i<8; i++)
                   {
                     IMU963RA_SCK (0);
                     IMU963RA_MOSI(byte&0x80);
                     byte <<= 1;
                     IMU963RA_SCK (1);
                     byte |= IMU963RA_MISO;
                   }
                   IMU963RA_SCK (0);
                   return(byte);
                 }
                 
                 
