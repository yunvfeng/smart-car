   19          void Params_Init(void) {
   20   1          // 动力学域
   21   1          g_Params.base_speed        = 500;  
   22   1          g_Params.target_speed      = 50;   
   23   1          g_Params.max_speed_limit   = 2000;  // 对应 MOTOR_MAX_LIMIT
   24   1          g_Params.stall_protect_err = 1000;  // 速度偏差大于 4000 视为可能堵转
   25   1      
   26   1          // 转向域 (定点数 Q10 格式: 1.0 -> 1024)
   27   1          g_Params.Kp_Steer          = 4500;  // float 1.8
   28   1          g_Params.Kd_Steer          = 2000;  // float 6.0 
   29   1          g_Params.Kf_Curve          = 1000;   // float 0.5 (前馈系数，根据曲率提前动作)
   30   1          g_Params.servo_center      = 700;   // 引用自 servo.h 的默认中值
   31   1      
   32   1          // 电机域
   33   1          g_Params.Kp_Motor          = 1024;  // float 1.0
   34   1          g_Params.Ki_Motor          = 150;   // float 0.15
   35   1      
   36   1          // 视觉域
   37   1          g_Params.target_lost_tolerance = 5; 
   38   1          g_Params.laser_shoot_delay     = 200; 
   39   1          g_Params.aim_offset_x          = 0;   // 发车前根据实际激光落点在此调参校准
   40   1          g_Params.aim_offset_y          = -20; // 假设激光器装在摄像头下方，存在 Y 轴偏差
   41   1      }
   42          void Params_Load(void) {
   43   1          uint8 magic;
   44   1          iap_init(); 
   45   1          
   46   1          magic = iap_read_byte(SAVE_ADDR);
   47   1          
   48   1          if (magic == PARAMS_MAGIC) {
   49   2              // 使用正确的结构体名字 SystemParams_t 
   50   2              iap_read_buff(SAVE_ADDR + 1, (uint8 *)&g_Params, sizeof(SystemParams_t));
