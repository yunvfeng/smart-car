    6          // 定义存储地址（从 0 地址开始存储）
    7          #define SAVE_ADDR       0x0000  
    8          // 定义校验魔数，用于判断 EEPROM 是否曾经写入过数据
    9          #define PARAMS_MAGIC    0x5A
