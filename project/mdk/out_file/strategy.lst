   40          // --- 电机控制任务：参数全开放 ---
   41          void Motor_Control_Task(int16 base_speed, int16 curvature, int16 steering_offset, 
   42                                  int32 kp, int32 ki, int32 kd, int32 ack_k) {
   43   1          int32 delta_v;
   44   1          int16 target_L, target_R;
   45   1          int16 speed_now_L, speed_now_R;
   46   1          int16 pwm_out_L, pwm_out_R;
   47   1          int16 planned_speed; // 规划后的目标速度
   48   1      
   49   1          if (base_speed <= 0) {
   50   2              Motor_L_PID.target = 0;
   51   2              Motor_R_PID.target = 0;
   52   2              Motor_L_PID.out_accum = 0; // 清空 PID 累加
   53   2              Motor_R_PID.out_accum = 0;
   54   2              Set_Motor_PWM(0, 0); 
   55   2              return; 
   56   2          }
C251 COMPILER V5.60.0,  strategy                                                           02/05/26  17:12:21  PAGE 2   

   57   1          // ==========================================================
   58   1          // 1. 动态速度规划 (Dynamic Speed Planning)
   59   1          // 逻辑：根据当前赛道曲率绝对值进行非线性减速，防止急弯冲出
   60   1          // ==========================================================
   61   1          // 这里的 12 为减速系数（Q0），可根据实际路况在参数管理中增加该变量
   62   1          planned_speed = base_speed - (abs(curvature) * 12); 
   63   1          if (planned_speed < 100) planned_speed = 100; // 强制保底速度，防止由于计算偏差导致停车
   64   1      
   65   1          // 2. 实时更新 PID 参数[cite: 1]
   66   1          Motor_L_PID.p = Motor_R_PID.p = kp;
   67   1          Motor_L_PID.i = Motor_R_PID.i = ki;
   68   1          Motor_L_PID.d = Motor_R_PID.d = kd;
   69   1      
   70   1          // 3. 阿克曼差速计算 (基于规划后的速度)[cite: 1]
   71   1          delta_v = ((int32)planned_speed * ack_k * steering_offset) >> 14; 
   72   1          target_L = planned_speed + (int16)delta_v;
   73   1          target_R = planned_speed - (int16)delta_v;
   74   1      
   75   1          Motor_L_PID.target = target_L;
   76   1          Motor_R_PID.target = target_R;
   77   1      
   78   1          // 4. 执行速度环 PID 并输出[cite: 1]
   79   1          Get_Speed(&speed_now_L, &speed_now_R);
   80   1          Cur_PWM_L = PID_Compute_Inc(&Motor_L_PID, speed_now_L);
   81   1          Cur_PWM_R = PID_Compute_Inc(&Motor_R_PID, speed_now_R);
   82   1          pwm_out_L = Cur_PWM_L;
   83   1          pwm_out_R = Cur_PWM_R;
   84   1          Set_Motor_PWM(pwm_out_L, pwm_out_R); 
   85   1      }


