    9          // --- 舵机控制任务：参数全开放 ---
   10          int16 Servo_Control_Task(int16 current_error, int16 curvature, int16 current_speed, 
   11                                   int32 kp, int32 kd, int32 kff1, int32 kff2) {
   12   1          int32 pd_feedback;
   13   1          int32 feedforward;
   14   1          int32 v_square;
   15   1          int16 final_offset;
   16   1          int16 final_duty;
   17   1      
   18   1          // 实时更新 PID 结构体参数 (来自 WiFi 调参变量)
   19   1          Steer_PID.p = kp;
   20   1          Steer_PID.d = kd;
   21   1      
   22   1          // 1. 反馈计算
   23   1          pd_feedback = PID_Compute_Pos(&Steer_PID, current_error);
   24   1      
   25   1          // 2. 前馈计算 (使用传入的 kff1, kff2)
   26   1          v_square = (int32)current_speed * current_speed;
   27   1          feedforward = (kff1 * curvature) + ((kff2 * v_square * curvature) >> 15);
   28   1          feedforward = feedforward >> 10; 
   29   1      
   30   1          final_offset = (int16)(feedforward + pd_feedback);
   31   1          final_duty = STEER_CENTER + final_offset;
   32   1      
   33   1          if (final_duty > STEER_MAX_LIMIT) final_duty = STEER_MAX_LIMIT;
   34   1          if (final_duty < STEER_MIN_LIMIT) final_duty = STEER_MIN_LIMIT;
   35   1      
   36   1          Set_Servo_Duty(final_duty);
   37   1          return (final_duty - STEER_CENTER); 
   38   1      }
