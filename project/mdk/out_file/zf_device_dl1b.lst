   81          void dl1b_get_distance (void)
   82          {
   83   1          if(dl1b_init_flag)
   84   1          {
   85   2              uint8 data_buffer[3];
   86   2              int16 dl1b_distance_temp = 0;
   87   2              
   88   2              data_buffer[0] = DL1B_GPIO__TIO_HV_STATUS >> 8;
   89   2              data_buffer[1] = DL1B_GPIO__TIO_HV_STATUS & 0xFF;
   90   2              dl1b_transfer_8bit_array(data_buffer, 2, &data_buffer[2], 1);
   91   2              
   92   2              if(DL1B_DATA_READY_LEVEL == (data_buffer[2] & 0x01))
   93   2              {
   94   3                  data_buffer[0] = DL1B_RESULT__RANGE_STATUS >> 8;
   95   3                  data_buffer[1] = DL1B_RESULT__RANGE_STATUS & 0xFF;
   96   3                  dl1b_transfer_8bit_array(data_buffer, 2, &data_buffer[2], 1);
   97   3                  
   98   3                  if(0x09 == (data_buffer[2] & 0x1F))
   99   3                  {
  100   4                      data_buffer[0] = DL1B_RESULT__FINAL_CROSSTALK_CORRECTED_RANGE_MM_SD0 >> 8;
  101   4                      data_buffer[1] = DL1B_RESULT__FINAL_CROSSTALK_CORRECTED_RANGE_MM_SD0 & 0xFF;
  102   4                      dl1b_transfer_8bit_array(data_buffer, 2, data_buffer, 2);
  103   4                      dl1b_distance_temp = data_buffer[0];
  104   4                      dl1b_distance_temp = (dl1b_distance_temp << 8) | data_buffer[1];
  105   4                      
  106   4                      if(dl1b_distance_temp > 4000 || dl1b_distance_temp < 0)
  107   4                      {
  108   5                          dl1b_distance_mm = 8192;
  109   5                          dl1b_finsh_flag = 0;
  110   5                      }
  111   4                      else
  112   4                      {
  113   5                          dl1b_distance_mm = dl1b_distance_temp;
  114   5                          dl1b_finsh_flag = 1;
